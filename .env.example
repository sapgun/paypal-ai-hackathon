# Copy to .env.local. Never commit real keys.
# This app talks only to the PayPal Sandbox. PAYPAL_ENV=live is rejected.

# Set to true to force the built-in demo agent and the simulated PayPal
# gateway even if keys are present. Leave unset to auto-detect:
# missing keys run that half of the flow in demo mode.
DEMO_MODE=true

# PayPal Sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Public origin used for PayPal return and cancel URLs.
APP_BASE_URL=http://localhost:3000

# Optional OpenAI-compatible chat completions API.
# Leave LLM_API_KEY empty to use the deterministic demo parser.
# The model may only choose catalog SKUs and quantities. It cannot set prices.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
